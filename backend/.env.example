# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Gemini AI Configuration (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Application Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Telegram Emergency Bot Configuration (Free Official Bot API)
# Create your bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=BhaavaBotSafetyBot
TELEGRAM_MODE=simulation  # Options: simulation | live
TELEGRAM_WEBHOOK_SECRET=your_optional_webhook_secret_here

